# Copiar este archivo a .env y llenar con los valores reales (nunca subir .env a Git)
PORT=4000

DB_HOST=127.0.0.1
# Nota: si usas XAMPP y el puerto 3306 ya está ocupado por otro MySQL instalado
# en tu equipo (por ejemplo uno instalado para materias de Bases de Datos),
# XAMPP arranca su propio MySQL en el 3307 automaticamente. Revisa el puerto
# real en el XAMPP Control Panel (columna "Port(s)") y ajústalo aquí.
DB_PORT=3307
DB_NAME=cindec_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=cambia_esto_por_un_valor_secreto_largo
