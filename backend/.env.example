# Copiar este archivo a .env y llenar con los valores reales (nunca subir .env a Git)
NODE_ENV=development
PORT=4000

# MySQL Server 8.0 local (MySQL Workbench), no el de XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cindec_db
DB_USER=root
DB_PASSWORD=

# Secreto para firmar los tokens JWT (una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_valor_secreto_largo
JWT_EXPIRES_IN=8h

# Dirección del frontend (Vite): CORS y enlaces que se envían por correo
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Correo (RF-USR-06, RF-NOT-01). Si SMTP_HOST se deja vacío, en desarrollo se usa
# el buzón de prueba Ethereal y el enlace para ver cada correo sale en la consola.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=cuenta@gmail.com
# y SMTP_PASSWORD = "contraseña de aplicación" de Google (no la contraseña normal).
# Para probar sin internet: CORREO_MODO=archivo guarda cada correo como .html en backend/correos-prueba/
# (también se activa solo si Ethereal no responde).
CORREO_MODO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Recordatorios automáticos por correo (próxima sesión y evaluaciones pendientes); false para apagarlos
RECORDATORIOS_AUTOMATICOS=true
CORREO_REMITENTE=Sistema CINDEC <no-responder@cindec.com>
